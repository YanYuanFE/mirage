PORT=8787
RPC_URL=https://api.zan.top/public/starknet-mainnet/rpc/v0_10

# SDK route — pending from organizers (strk20-hackathon issue #135)
PROVING_SERVICE_URL=
INDEXER_URL=

# Engine's own pool account (register once, then users transfer privately to it)
ACCOUNT_ADDRESS=
ACCOUNT_PRIVATE_KEY=
VIEWING_KEY=

# Optional
ONECLICK_JWT=
DRY_RUN=1

# Required once DRY_RUN=0: every route except /health checks this bearer token.
# The engine spends its own pool balance, so an open port is an open wallet.
API_TOKEN=
